NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHAVE MESTRA — ignora toda Row Level Security. NUNCA prefixar com NEXT_PUBLIC_,
# NUNCA importar em Client Component, NUNCA logar. Só é lida em lib/supabase/admin.ts
# (server-only) e usada em serviços que precisam da Auth Admin API (convidar líder,
# autocadastro de participante, criação direta de conta) — cada uso tem checagem
# redundante de papel no mesmo arquivo. Se vazar, rotacione na página do projeto em
# supabase.com/dashboard/project/_/settings/api imediatamente.
SUPABASE_SERVICE_ROLE_KEY=

# Mural de fotos e vídeos — Google Drive.
# Passo a passo completo no DEPLOY.md, seção "Mural de fotos e vídeos".
# Sem estas quatro, a aba Mural mostra o que já existe mas não aceita
# envio novo. Em produção elas vivem nas variáveis do Netlify.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
